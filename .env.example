# Copy to .env and fill in. .env is gitignored and never committed.

# Base URL of your Keitaro tracker (the admin host), without the /admin_api/v1 suffix.
KEITARO_BASE_URL=https://your-tracker.example.com

# Admin API key: Keitaro → Profile → API keys.
KEITARO_API_KEY=

# Defaults pre-filled in the "New campaign" form (names as shown in Keitaro).
# They can be overridden per campaign in the form's Advanced section.
KEITARO_DEFAULT_DOMAIN=
KEITARO_DEFAULT_GROUP=
KEITARO_DEFAULT_SOURCE=

# Local database (SQLite by default).
# DATABASE_URL=sqlite:////absolute/path/app.db   (default: <repo>/data/app.db)

# Run against a built-in fake tracker with demo data instead of a real Keitaro
# (no key needed; nothing leaves your machine). Used by the end-to-end tests.
# KEITARO_FAKE=1
# KEITARO_FAKE_STATE=/absolute/path/data/fake-keitaro.json   (fake mode: keep its data across restarts)

# Host names the API answers to (default: localhost and 127.0.0.1). Requests for any other host,
# and writes from another site's page, are refused. Add your LAN address to open the app from
# another device, e.g. after starting uvicorn with --host 0.0.0.0:
# ALLOWED_HOSTS=["localhost","127.0.0.1","192.168.1.5"]
