    "properties": {
     "detail": {
      "$ref": "#/components/schemas/FlowProblem"
     }
    },
    "type": "object",
    "required": [
     "detail"
    ],
    "title": "FlowProblemBody"
   },
   "FlowView": {
    "properties": {
     "stream_id": {
      "type": "integer",
      "title": "Stream Id"
     },
     "name": {
      "type": "string",
      "title": "Name"
     },
     "type": {
      "type": "string",
      "title": "Type"
     },
     "position": {
      "type": "integer",
      "title": "Position"
     },
     "summary": {
      "type": "string",
