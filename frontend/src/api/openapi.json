 "components": {
  "schemas": {
   "AddIn": {
    "properties": {
     "kind": {
      "type": "string",
      "const": "add",
      "title": "Kind"
     },
     "offer_id": {
      "type": "integer",
      "title": "Offer Id"
     }
    },
    "type": "object",
    "required": [
     "kind",
     "offer_id"
    ],
    "title": "AddIn"
   },
   "BringBackIn": {
    "properties": {
     "kind": {
      "type": "string",
      "const": "bring_back",
      "title": "Kind"
     },
     "offer_id": {
      "type": "integer",
      "title": "Offer Id"
     }
    },
    "type": "object",
    "required": [
     "kind",
     "offer_id"
    ],
    "title": "BringBackIn"
   },
   "CampaignOut": {
    "properties": {
     "id": {
      "type": "integer",
      "title": "Id"
     },
     "name": {
      "type": "string",
      "title": "Name"
     },
     "alias": {
      "type": "string",
      "title": "Alias"
     },
     "state": {
      "type": "string",
      "title": "State"
     },
     "group": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Group"
     },
     "domain": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Domain",
      "description": "host only, e.g. track.example"
     }
    },
    "type": "object",
    "required": [
     "id",
     "name",
     "alias",
     "state",
     "group",
     "domain"
    ],
    "title": "CampaignOut"
   },
   "CampaignRef": {
    "properties": {
     "id": {
      "type": "integer",
      "title": "Id"
     },
     "name": {
      "type": "string",
      "title": "Name"
     }
    },
    "type": "object",
    "required": [
     "id",
     "name"
    ],
    "title": "CampaignRef"
   },
   "CreateCampaignIn": {
    "properties": {
     "name": {
      "type": "string",
      "minLength": 1,
      "title": "Name"
     },
     "geos": {
      "items": {
       "type": "string"
      },
      "type": "array",
      "minItems": 1,
      "title": "Geos",
      "description": "ISO 3166-1 alpha-2 codes sent to google.com"
     },
     "offer_id": {
      "type": "integer",
      "title": "Offer Id"
     },
     "domain_id": {
      "anyOf": [
       {
        "type": "integer"
       },
       {
        "type": "null"
       }
      ],
      "title": "Domain Id"
     },
     "group_id": {
      "anyOf": [
       {
        "type": "integer"
       },
       {
        "type": "null"
       }
      ],
      "title": "Group Id"
     },
     "source_id": {
      "anyOf": [
       {
        "type": "integer"
       },
       {
        "type": "null"
       }
      ],
      "title": "Source Id"
     },
     "idempotency_key": {
      "type": "string",
      "maxLength": 64,
      "minLength": 8,
      "title": "Idempotency Key"
     }
    },
    "type": "object",
    "required": [
     "name",
     "geos",
     "offer_id",
     "idempotency_key"
    ],
    "title": "CreateCampaignIn"
   },
   "CreateCampaignOut": {
    "properties": {
     "campaign_id": {
      "type": "integer",
      "title": "Campaign Id"
     }
    },
    "type": "object",
    "required": [
     "campaign_id"
    ],
    "title": "CreateCampaignOut"
   },
   "Defaults": {
    "properties": {
     "domain_id": {
      "anyOf": [
       {
        "type": "integer"
       },
       {
        "type": "null"
       }
      ],
      "title": "Domain Id"
     },
     "group_id": {
      "anyOf": [
       {
        "type": "integer"
       },
       {
        "type": "null"
       }
      ],
      "title": "Group Id"
     },
     "source_id": {
      "anyOf": [
       {
        "type": "integer"
       },
       {
        "type": "null"
       }
      ],
      "title": "Source Id"
     }
    },
    "type": "object",
    "required": [
     "domain_id",
     "group_id",
     "source_id"
    ],
    "title": "Defaults"
   },
   "EditorView": {
    "properties": {
     "campaign": {
      "$ref": "#/components/schemas/CampaignRef"
     },
     "kt_url": {
      "type": "string",
      "title": "Kt Url"
     },
     "fetched_at": {
      "anyOf": [
       {
        "type": "string",
        "format": "date-time"
       },
       {
        "type": "null"
       }
      ],
      "title": "Fetched At"
     },
     "flows": {
      "items": {
       "$ref": "#/components/schemas/FlowView"
      },
      "type": "array",
      "title": "Flows"
     },
     "notes": {
      "items": {
       "type": "string"
      },
      "type": "array",
      "title": "Notes"
     }
    },
    "type": "object",
    "required": [
     "campaign",
     "kt_url",
     "fetched_at",
     "flows",
     "notes"
    ],
    "title": "EditorView"
   },
   "FlowProblem": {
    "properties": {
     "kind": {
      "type": "string",
