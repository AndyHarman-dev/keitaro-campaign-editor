{
 "openapi": "3.1.0",
 "info": {
  "title": "Keitaro Campaign Editor",
  "version": "0.1.0"
 },
 "paths": {
  "/api/campaigns": {
   "get": {
    "summary": "List Campaigns",
    "operationId": "list_campaigns_api_campaigns_get",
    "parameters": [
     {
      "name": "q",
      "in": "query",
      "required": false,
      "schema": {
       "type": "string",
       "default": "",
       "title": "Q"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "type": "array",
         "items": {
          "$ref": "#/components/schemas/CampaignOut"
         },
         "title": "Response List Campaigns Api Campaigns Get"
        }
       }
      }
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    }
   },
   "post": {
    "summary": "Create",
    "operationId": "create_api_campaigns_post",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/CreateCampaignIn"
       }
      }
     }
    },
    "responses": {
     "201": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/CreateCampaignOut"
        }
       }
      }
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    }
   }
  },
  "/api/lookups": {
   "get": {
    "summary": "Lookups",
    "operationId": "lookups_api_lookups_get",
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/LookupsOut"
        }
       }
      }
     }
    }
   }
  },
  "/api/offers": {
   "get": {
    "summary": "Search Offers",
    "operationId": "search_offers_api_offers_get",
    "parameters": [
     {
      "name": "q",
      "in": "query",
      "required": false,
      "schema": {
       "type": "string",
       "default": "",
       "title": "Q"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "type": "array",
         "items": {
          "$ref": "#/components/schemas/OfferOut"
         },
         "title": "Response Search Offers Api Offers Get"
        }
       }
      }
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    }
   }
  },
  "/api/health": {
   "get": {
    "summary": "Health",
    "operationId": "health_api_health_get",
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "additionalProperties": true,
         "type": "object",
         "title": "Response Health Api Health Get"
        }
       }
      }
     }
    }
   }
  },
  "/api/keitaro/ping": {
   "get": {
    "summary": "Keitaro Ping",
    "description": "Checks that the tracker URL and API key in .env work (lists campaign count).",
    "operationId": "keitaro_ping_api_keitaro_ping_get",
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "additionalProperties": true,
         "type": "object",
         "title": "Response Keitaro Ping Api Keitaro Ping Get"
        }
       }
      }
     }
    }
   }
  }
 },
 "components": {
  "schemas": {
   "CampaignOut": {
    "properties": {
     "id": {
      "type": "integer",
      "title": "Id"
     },
     "name": {
      "type": "string",
      "title": "Name"
     },
     "alias": {
      "type": "string",
      "title": "Alias"
     },
     "state": {
      "type": "string",
      "title": "State"
     }
    },
    "type": "object",
    "required": [
     "id",
     "name",
     "alias",
     "state"
    ],
    "title": "CampaignOut"
   },
   "CreateCampaignIn": {
    "properties": {
     "name": {
      "type": "string",
      "minLength": 1,
      "title": "Name"
     },
     "geos": {
      "items": {
       "type": "string"
      },
      "type": "array",
      "minItems": 1,
      "title": "Geos",
      "description": "ISO 3166-1 alpha-2 codes sent to google.com"
     },
     "offer_id": {
      "type": "integer",
      "title": "Offer Id"
     },
     "domain_id": {
      "anyOf": [
       {
        "type": "integer"
       },
       {
        "type": "null"
       }
      ],
      "title": "Domain Id"
     },
     "group_id": {
      "anyOf": [
       {
        "type": "integer"
       },
       {
        "type": "null"
       }
      ],
      "title": "Group Id"
     },
     "source_id": {
      "anyOf": [
       {
        "type": "integer"
       },
       {
        "type": "null"
       }
      ],
      "title": "Source Id"
     },
     "idempotency_key": {
      "type": "string",
      "maxLength": 64,
      "minLength": 8,
      "title": "Idempotency Key"
     }
    },
    "type": "object",
    "required": [
     "name",
     "geos",
     "offer_id",
     "idempotency_key"
    ],
    "title": "CreateCampaignIn"
   },
   "CreateCampaignOut": {
    "properties": {
     "campaign_id": {
      "type": "integer",
      "title": "Campaign Id"
     }
    },
    "type": "object",
    "required": [
     "campaign_id"
    ],
    "title": "CreateCampaignOut"
   },
   "Defaults": {
    "properties": {
     "domain_id": {
      "anyOf": [
       {
        "type": "integer"
       },
       {
        "type": "null"
       }
      ],
      "title": "Domain Id"
     },
     "group_id": {
      "anyOf": [
       {
        "type": "integer"
       },
       {
        "type": "null"
       }
      ],
      "title": "Group Id"
     },
     "source_id": {
      "anyOf": [
       {
        "type": "integer"
       },
       {
        "type": "null"
       }
      ],
      "title": "Source Id"
     }
    },
    "type": "object",
    "required": [
     "domain_id",
     "group_id",
     "source_id"
    ],
    "title": "Defaults"
   },
   "HTTPValidationError": {
    "properties": {
     "detail": {
      "items": {
       "$ref": "#/components/schemas/ValidationError"
      },
      "type": "array",
      "title": "Detail"
     }
    },
    "type": "object",
    "title": "HTTPValidationError"
   },
   "LookupsOut": {
    "properties": {
     "domains": {
      "items": {
       "$ref": "#/components/schemas/Named"
      },
      "type": "array",
      "title": "Domains"
     },
     "groups": {
      "items": {
       "$ref": "#/components/schemas/Named"
      },
      "type": "array",
      "title": "Groups"
     },
     "sources": {
      "items": {
       "$ref": "#/components/schemas/Named"
      },
      "type": "array",
      "title": "Sources"
     },
     "defaults": {
      "$ref": "#/components/schemas/Defaults"
     },
     "problems": {
      "items": {
       "type": "string"
      },
      "type": "array",
      "title": "Problems"
     }
    },
    "type": "object",
    "required": [
     "domains",
     "groups",
     "sources",
     "defaults",
     "problems"
    ],
    "title": "LookupsOut"
   },
   "Named": {
    "properties": {
     "id": {
      "type": "integer",
      "title": "Id"
     },
     "name": {
      "type": "string",
      "title": "Name"
     }
    },
    "type": "object",
    "required": [
     "id",
     "name"
    ],
    "title": "Named"
   },
   "OfferOut": {
    "properties": {
     "id": {
      "type": "integer",
      "title": "Id"
     },
     "name": {
      "type": "string",
      "title": "Name"
     }
    },
    "type": "object",
    "required": [
     "id",
     "name"
    ],
    "title": "OfferOut"
   },
   "ValidationError": {
    "properties": {
     "loc": {
      "items": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "integer"
        }
       ]
      },
      "type": "array",
      "title": "Location"
     },
     "msg": {
      "type": "string",
      "title": "Message"
     },
     "type": {
      "type": "string",
      "title": "Error Type"
     },
     "input": {
      "title": "Input"
     },
     "ctx": {
      "type": "object",
      "title": "Context"
     }
    },
    "type": "object",
    "required": [
     "loc",
     "msg",
     "type"
    ],
    "title": "ValidationError"
   }
  }
 }
}
